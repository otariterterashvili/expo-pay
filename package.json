{
  "name": "expo-pay",
  "version": "0.1.1",
  "description": "Expo native module for Android Google Pay payment buttons and payment sheets.",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "files": [
    "android/build.gradle",
    "android/src/main/AndroidManifest.xml",
    "android/src/main/java",
    "build",
    "src/*.ts",
    "src/*.tsx",
    "expo-module.config.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node internal/module_scripts/build.js",
    "clean": "node internal/module_scripts/clean.js",
    "lint": "eslint src/",
    "test": "node internal/module_scripts/test.js",
    "prepare": "node internal/module_scripts/prepare.js",
    "open:ios": "node internal/module_scripts/open-ios.js",
    "open:android": "node internal/module_scripts/open-android.js"
  },
  "keywords": [
    "android",
    "google-pay",
    "google-pay-button",
    "payments",
    "react-native",
    "expo",
    "expo-module",
    "expo-pay"
  ],
  "repository": "https://github.com/otariterterashvili/expo-pay",
  "bugs": {
    "url": "https://github.com/otariterterashvili/expo-pay/issues"
  },
  "author": "Otar Terterashvili <terterashviliotari@gmail.com> (https://github.com/otariterterashvili)",
  "license": "MIT",
  "homepage": "https://github.com/otariterterashvili/expo-pay#readme",
  "dependencies": {},
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@types/jest": "^29.2.1",
    "@types/react": "~19.1.1",
    "babel-preset-expo": "~55.0.8",
    "eslint": "~9.39.4",
    "eslint-config-universe": "^15.0.3",
    "expo": "^56.0.11",
    "jest": "^29.7.0",
    "jest-expo": "~55.0.9",
    "prettier": "^3.0.0",
    "react-native": "0.82.1",
    "typescript": "^5.9.2"
  },
  "jest": {
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src"
    ],
    "transform": {
      "^.+\\.[jt]sx?$": [
        "babel-jest",
        {
          "presets": [
            "babel-preset-expo"
          ]
        }
      ]
    },
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json"
    ]
  },
  "peerDependencies": {
    "expo": "*",
    "react": "*",
    "react-native": "*"
  }
}
